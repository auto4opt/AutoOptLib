include LICENSE README.md pyproject.toml setup.py
recursive-include src/autooptlib *.py *.cpp *.hpp NUMPY_LICENSE.txt
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
prune build
prune dist
prune results
prune experiments
prune comparisons
prune manuscript
global-exclude __pycache__ *.py[cod] *.so *.dylib *.pyd .DS_Store
